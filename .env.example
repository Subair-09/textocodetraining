# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_GROUP_INVITE_LINK: The invitation link for the Textocode Academy WhatsApp group.
WHATSAPP_GROUP_INVITE_LINK="https://chat.whatsapp.com/KOOLm8HsTeC4PFNRBPEffx?s=cl&p=a&mlu=4&ilr=4"

# META_PIXEL_ID: Your 15-16 digit Meta (Facebook) Pixel ID (e.g. 1234567890123456).
# REQUIRED for Meta Pixel tracking (fires PageView on all pages, CompleteRegistration & Lead on /thankyou).
META_PIXEL_ID="YOUR_META_PIXEL_ID"

# META_ACCESS_TOKEN: (Recommended) Meta Conversions API (CAPI) System User Access Token.
# Enables server-side conversion tracking so you never lose events to ad blockers or iOS restrictions.
META_ACCESS_TOKEN="YOUR_META_CONVERSIONS_API_ACCESS_TOKEN"
